# Copy outside a release directory as /opt/apps/oma-studio/.env.ops.
# These are host paths used by Docker Compose, never container paths.
COMPOSE_PROJECT_NAME=oma-studio
OMA_BIND_ADDRESS=127.0.0.1
OMA_PORT=8000
PI_PLATFORM_DATA_DIR=/opt/apps/oma-studio/shared/oma/data
PI_CWD=/opt/apps/oma-studio/shared/oma/workspace
PI_LOG_DIR=/opt/apps/oma-studio/shared/logs
PI_HOST_HOME=/opt/apps/oma-studio/shared/pi-home/agent
PI_DOCKER_CWD=/workspace
PI_PROVIDER=
PI_MODEL=
PI_THINKING_LEVEL=low
PI_DEFAULT_TOOLS=read,write,edit,bash
PI_DEFAULT_EXTENSIONS=
PI_DEFAULT_SKILLS=
PI_DEFAULT_MCP_SERVERS=
PI_MODE=production
OMA_PROXY=
OMA_ADMIN_PASSWORD=replace-before-deploying
OMA_DEFAULT_USER_PASSWORD=replace-before-deploying
