# Path to the Pi CLI. Use `pi` when it is on PATH.
PI_CLI_PATH=pi

# Platform metadata and Pi session storage.
# Normalized layout, decoupled from this repo; must be absolute (no ~ expansion
# in this file). Docker mounts ~/.oma-studio/ to the same locations.
PI_PLATFORM_DATA_DIR=/absolute/path/to/.oma-studio/data
PI_SESSION_DIR=/absolute/path/to/.oma-studio/data/pi-sessions

# Pi's working directory. This is a default directory, not a security sandbox.
PI_CWD=/absolute/path/to/.oma-studio/workspace
# Optional container path for migrated Pi sessions whose stored cwd is absolute.
# Leave empty for new Docker installations; use the stored session cwd when migrating.
PI_DOCKER_CWD=

# Pi's user configuration directory.
PI_HOME=~/.pi/agent

# Optional global Provider and Model defaults. Agents can override these.
PI_PROVIDER=deepseek
PI_MODEL=
PI_THINKING_LEVEL=low

# Platform web tools. web_fetch uses Jina Reader; web_search uses Baidu Qianfan Search.
JINA_API_KEY=
BAIDU_SEARCH_API_KEY=your-baidu-qianfan-api-key
BAIDU_SEARCH_BASE_URL=https://qianfan.baidubce.com

# Defaults selected when opening the New Agent dialog. Values are comma-separated.
# Extensions and skills are matched by discovered name; MCP servers use their server name.
PI_DEFAULT_TOOLS=read,write,edit,bash
PI_DEFAULT_EXTENSIONS=pi-mcp-adapter
PI_DEFAULT_SKILLS=
PI_DEFAULT_MCP_SERVERS=

# Presentation mode. Production hides process-only tool calls; use the URL
# query ?mode=development for temporary browser-side diagnostics.
PI_MODE=production

# Outbound proxy for the Docker container's model-API calls (optional).
# With Colima the host is reachable at http://192.168.5.2:7897-style addresses;
# leave empty for direct connections (CI, Docker Desktop usually direct too).
OMA_PROXY=
